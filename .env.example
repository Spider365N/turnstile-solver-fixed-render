# Copy to .env and adjust. All values shown are defaults.

# HTTP service
PORT=9988
MAX_WORKERS=4
MAX_BODY_BYTES=65536
LOG_LEVEL=INFO

# Interface the port publishes on (compose reads this file). 127.0.0.1 = loopback
# behind a reverse proxy (default, safest). 0.0.0.0 = reachable by other hosts —
# only together with API_KEY, e.g. your own servers over a tailnet.
SOLVER_BIND=127.0.0.1

# API key gate. Empty = auth disabled (dev). When set, every path except
# /health requires the key via `X-API-Key` header or `?api_key=`.
API_KEY=

# Anti-abuse per client IP (0 = off, the default). Exceeding RATE_LIMIT_PER_MIN
# bans the IP for BAN_SECONDS and kills its in-flight solves. With
# RATE_LIMIT_PER_MIN=0 no bans are issued or enforced.
RATE_LIMIT_PER_MIN=0
MAX_CONCURRENT_PER_IP=0
BAN_SECONDS=86400
# Client IPs / CIDRs with no rate limit, ban or concurrency cap at all (your
# own servers), comma separated: "1.2.3.4, 10.0.0.0/8". Everyone behind the
# same NAT/proxy bypasses too — pair with API_KEY when the port is reachable
# by others.
RATE_LIMIT_BYPASS_IPS=
# 1 = allow siteurl to target loopback/private/link-local hosts (dev only;
# blocked by default to stop SSRF into the docker network).
ALLOW_PRIVATE_TARGETS=

# SQLite (WAL) for persisted bans + counters. Keep on a named volume.
DB_PATH=/data/solver.db

# Outbound egress proxy for the browser + byparr (e.g. WARP HTTP proxy).
# Empty = direct connection (RECOMMENDED for single-container deploys on
# Railway / Render / Fly / Koyeb etc. where the 'warp' hostname does not
# exist). Only set to http://warp:8080 when you run the full docker-compose
# stack (solver + warp + byparr on the same network).
# WARP round-robins across instances on this one port — raise WARP_INSTANCES
# in docker-compose for per-request IP rotation.
SOLVER_PROXY=

# Challenge proxy (Byparr / FlareSolverr-compatible). Delegates /solve-challenge.
# Leave empty for single-container. Only set when byparr service is reachable.
CHALLENGE_PROXY_URL=
CHALLENGE_PROXY_KIND=byparr

# Camoufox headless mode:
#   virtual  = Camoufox starts its own isolated Xvfb (RECOMMENDED for Render /
#              Railway / any restricted container). Avoids uid_map EPERM and
#              "cannot open display" races.
#   false    = shared Xvfb managed by entrypoint (needs working DISPLAY)
#   true     = pure headless (Cloudflare widgets often refuse to mount)
HEADLESS=virtual
TS_PROFILE_DIR=/tmp/ts_profile

# These are also set in the Dockerfile. Keep them if you override the image.
MOZ_DISABLE_CONTENT_SANDBOX=1
MOZ_DISABLE_GMP_SANDBOX=1
MOZ_DISABLE_RDD_SANDBOX=1
MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1
CAMOUFOX_VIRTUAL_DISPLAY_SIZE=1920x1080x24
